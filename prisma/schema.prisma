generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String    @unique
  password  String
  image     String?
  provider  String?   @default("Email")
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  reservation   Reservation[]
  cars          Car[]
  reviews       Review[]
  announcements Announcement[]
}

model Car {
  id        String   @id @default(uuid())
  brand     String
  model     String
  year      Int
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  clientId  String

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  announcements Announcement[] // <-- nowe pole
}

model Business {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  phone        String   @unique
  name         String
  owner        String
  category     String
  image        String?
  provider     String   @default("Email")
  town         String
  zipcode      String
  district     String
  street       String
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isPublic     Boolean  @default(false)
  facebookUrl  String
  instagramUrl String
  websiteUrl   String

  workingDays  WorkingDay[]
  services     Service[]
  categories   Categories[]
  reservations Reservation[]
  reviews      Review[]
  offers       Offer[]
  images       Image[]
}

model Image {
  id       String @id @default(uuid())
  photoUrl String
  priority Int?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model WorkingDay {
  id        String   @id @default(uuid())
  dayOfWeek String
  open      String
  close     String
  isOpen    Boolean
  updatedAt DateTime @updatedAt

  serviceId String
  service   Business @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dayOfWeek], name: "serviceId_dayOfWeek")
}

model Review {
  id        String   @id @default(uuid())
  title     String
  content   String
  rate      Int
  createdAt DateTime @default(now())

  serviceId     String
  service       Business    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String
  price       String
  duration    Int
  archived    Boolean @default(false)

  serviceId String
  service   Business @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  categoryId String
  category   Categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  reservations ReservationServices[]
}

model Categories {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archived  Boolean  @default(false)

  serviceId String
  service   Business @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  services Service[]
}

model Reservation {
  id                String   @id @default(uuid())
  businessId        String
  reservationYear   Int
  reservationMonth  Int
  reservationStart  DateTime
  reservationEnd    DateTime
  duration          Int
  charge            Float
  status            String
  clientMessage     String?
  clientCar         String?
  clientName        String?
  clientPhone       String?
  isAddedByBusiness Boolean  @default(false)
  

  clientId String?
  client   Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services ReservationServices[]
  reviewId String?
  Review   Review?
}

model ReservationServices {
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceId     String

  @@id([reservationId, serviceId])
}

model Announcement {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  status      String   @default("open")
  title       String
  category    String
  town        String
  district    String
  description String

  carId    String
  car      Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offers   Offer[]
}

model Offer {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  description String

  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

model Article {
  id        String   @id @default(uuid())
  title     String
  image     String
  layout    String
  content   Json
  status    String
  createdAt DateTime @default(now())
}
